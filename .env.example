# LLM Provider (groq or openai)
LLM_PROVIDER=groq

# Groq (free at console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# TigerGraph Savanna (optional - can use local store without it)
TG_HOST=
TG_TOKEN=
TG_GRAPHNAME=olympics

# OpenAI (fallback, only if not using Groq)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
