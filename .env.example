# LLM Provider (groq, gemini, or openai)
LLM_PROVIDER=groq

# Groq (free at console.groq.com) - multiple keys for fallback, comma-separated
GROQ_API_KEY=key1,key2,key3
GROQ_MODEL=llama-3.1-70b-versatile

# Gemini (Google AI Studio) - multiple keys for fallback, comma-separated
GEMINI_API_KEY=key1,key2
GEMINI_MODEL=gemini-2.0-flash

# TigerGraph Savanna (optional - can use local store without it)
TG_HOST=
TG_TOKEN=
TG_GRAPHNAME=olympics

# OpenAI - multiple keys for fallback, comma-separated
OPENAI_API_KEY=key1,key2
OPENAI_MODEL=gpt-4o